# Copy this file to .env, then replace the value with your real database URL.
#
# Local PostgreSQL example:
# DATABASE_URL=postgresql://your_username:your_password@localhost:5432/career_radar
#
# Some local PostgreSQL setups also work with:
# DATABASE_URL=postgresql:///career_radar

DATABASE_URL=postgresql://your_username:your_password@localhost:5432/career_radar

# Optional: needed only when running real AI enrichment, not dry runs.
# Create an API key in the OpenAI dashboard, then put it in your private .env.
OPENAI_API_KEY=

# Optional: override this if you want to use a different supported model.
OPENAI_MODEL=gpt-5

# Optional: live CSV export URL for the scheduled ChatGPT task inbox.
# This can be a published Google Sheet CSV link.
CHATGPT_INBOX_CSV_URL=
